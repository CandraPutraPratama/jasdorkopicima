{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jasdorkopicima",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "IMAGE_SOURCE": "r2",
    "NEXT_PUBLIC_CF_ANALYTICS_TOKEN": "e2df28ebcd454d6ca4f467570d8e7f60"
  },
  "routes": [
    {
      "pattern": "jasdor.cimagroup.my.id",
      "custom_domain": true
    }
  ]
}
