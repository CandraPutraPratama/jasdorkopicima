# ==========================================
# jasdorkopicima Environment Variables
# ==========================================
# CATATAN: File ini hanya berisi template / nama variabel.
# Salin file ini menjadi .env.local untuk penggunaan lokal.
# JANGAN PERNAH commit file .env atau .env.local ke git repository!

# --- Kopi Kenangan Unofficial API ---
# Nomor HP opsional (biarkan kosong "" untuk menggunakan sesi token tamu KK yang terverifikasi)
KOPI_KENANGAN_PHONE=

# Base URL API Kopi Kenangan Web Order
KOPI_KENANGAN_API_BASE=https://order.kopikenangan.com/web_order/api

# --- Supabase Database & Auth (Untuk Cache Outlet & Menu) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SYNC_SECRET=your-random-secret-for-outlet-sync-endpoint

# --- WhatsApp Pemilik Jastip (Tahap 6-7) ---
# Nomor WhatsApp tujuan pesan jastip customer (format 628xxx tanpa tanda + atau spasi)
NEXT_PUBLIC_WHATSAPP_PHONE=628xxxxxxxxxx

# --- Konfigurasi Bisnis ---
# Diskon harga dasar (0.50 = 50%)
NEXT_PUBLIC_BASE_DISCOUNT_PERCENT=0.50
# Fee jika order > 1 item (Rp)
NEXT_PUBLIC_FEE_MULTI_ITEM=2000
# Fee jika order hanya 1 item (Rp)
NEXT_PUBLIC_FEE_SINGLE_ITEM=4000

# Secret untuk sinkronisasi outlet harian (Cloudflare Cron Trigger / Header x-sync-secret)
SYNC_SECRET=your_random_sync_secret_here

# Mode simulasi jam buka tutup (hanya untuk dev lokal, kosongkan / jangan diset di production)
ALLOW_SIMULATE=false
